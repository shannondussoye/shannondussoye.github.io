---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { SITE } from "@/config";

type Props = {
  item: CollectionEntry<"workshop">;
};

const { item } = Astro.props;

const { title, description, heroImage, pubDatetime } = item.data;

const { Content } = await render(item);

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  description,
  pubDatetime,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main id="main-content" class="app-layout pb-12 mt-8">
    <div class="mb-8 overflow-hidden rounded-3xl border border-border">
      {
        heroImage && (
          <img
            src={heroImage}
            alt={title}
            class="aspect-[21/9] w-full object-cover"
          />
        )
      }
    </div>

    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl text-accent">
        {title}
      </h1>
      <p class="text-lg text-foreground/60 italic font-medium">
        {description}
      </p>
    </div>

    <article
      id="article"
      class="app-prose mt-12 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    <BackToTopButton />
  </main>
  <Footer />
</Layout>
