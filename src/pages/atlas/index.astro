---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const memories = await getCollection("atlas", ({ data }) => !data.draft);
const sortedMemories = memories.sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);

const memoriesWithContent = await Promise.all(
  sortedMemories.map(async memory => {
    const { Content } = await render(memory);
    return { ...memory, Content };
  })
);

// Grouping logic
const groupedMemories = memoriesWithContent.reduce((acc, memory) => {
  const year = memory.data.pubDatetime.getFullYear();
  const month = memory.data.pubDatetime.toLocaleString('en-US', { month: 'long' });
  
  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];
  
  acc[year][month].push(memory);
  return acc;
}, {} as Record<number, Record<string, typeof memoriesWithContent>>);

const years = Object.keys(groupedMemories).sort((a, b) => Number(b) - Number(a));
---

<Layout title={`Atlas | ${SITE.title}`}>
  <Header />
  
  <div class="fixed inset-0 top-16 sm:top-20 z-0 flex flex-col md:flex-row h-[calc(100vh-4rem)] sm:h-[calc(100vh-5rem)] overflow-hidden">
    <!-- MAP SIDE -->
    <div class="relative flex-1 h-1/2 md:h-full bg-background overflow-hidden flex items-center justify-center">
      <div class="absolute top-12 left-12 z-10 hidden md:block">
        <h1 class="text-3xl font-bold tracking-tighter text-accent">The Atlas</h1>
        <p id="atlas-subtitle" class="text-xs text-foreground/40 mt-1 uppercase tracking-widest font-mono">Archive // Global</p>
      </div>

      <!-- THE GLOBE CANVAS -->
      <div id="globe-container" class="relative w-[300px] h-[300px] sm:w-[500px] sm:h-[500px]">
        <canvas id="globe-canvas" class="w-full h-full cursor-grab active:cursor-grabbing opacity-0 transition-opacity duration-1000"></canvas>
      </div>

      <!-- Subtle Grid Background -->
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_center,var(--color-muted)_0%,transparent_100%)] opacity-20"></div>
    </div>

    <!-- FEED SIDE -->
    <div id="atlas-feed" class="flex-1 h-1/2 md:h-full overflow-y-auto px-6 sm:px-12 pt-12 pb-24 bg-background scroll-smooth relative">
      {/* Subtle Vertical Divider */}
      <div class="absolute left-0 top-0 bottom-0 w-px bg-border/20 hidden md:block z-10"></div>

      {years.map((year) => (
        <div class="year-group relative mb-48 pt-4" data-year={year}>
          {/* Ghost Background Year */}
          <div class="absolute -left-4 -top-12 text-9xl font-black tracking-tighter text-foreground/[0.015] select-none pointer-events-none z-0">
            {year}
          </div>

          {Object.keys(groupedMemories[Number(year)]).map((month) => (
            <div class="month-group mb-32 last:mb-0 relative z-10">
              <div class="flex flex-col mb-16">
                <div class="flex items-center gap-4 mb-2">
                  <span class="text-[10px] font-mono uppercase tracking-[0.5em] text-foreground/20 leading-none">{year}</span>
                  <div class="flex-1 h-px bg-gradient-to-r from-border/50 to-transparent"></div>
                </div>
                <h2 class="text-3xl font-black uppercase tracking-tight text-accent/90 leading-none">{month}</h2>
              </div>

              {groupedMemories[Number(year)][month].map((memory, index) => (
                <div 
                  class="atlas-card group mb-32 last:mb-0 opacity-20 filter grayscale transition-all duration-[800ms] scale-95"
                  data-lat={memory.data.coordinates[0]}
                  data-lng={memory.data.coordinates[1]}
                  id={`memory-${year}-${month}-${index}`}
                >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2 py-0.5 rounded bg-accent/10 border border-accent/20 text-[10px] font-bold text-accent uppercase tracking-widest">
              {memory.data.category}
            </span>
            <span class="text-[10px] font-mono text-foreground/40">
              {memory.data.location} // {memory.data.pubDatetime.toLocaleDateString('en-US', { year: 'numeric' })}
            </span>
          </div>
          
          <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-8">
            {memory.data.title}
          </h2>

          {memory.data.images && memory.data.images.length > 0 && (
            <div class="carousel-container relative w-full mb-8 group/carousel">
              <div class="carousel-wrapper flex overflow-x-auto snap-x snap-mandatory hide-scrollbar rounded-2xl border border-border bg-muted/20 shadow-2xl transition-all duration-500 group-hover:shadow-accent/5">
                {memory.data.images.map((img, i) => (
                  <div class="carousel-item flex-none w-full aspect-video snap-center overflow-hidden">
                    <img src={img} alt={`${memory.data.title} - image ${i + 1}`} class="w-full h-full object-cover transition-transform duration-700 group-hover/carousel:scale-[1.03]" loading="lazy" />
                  </div>
                ))}
              </div>
              
              {/* Navigation Arrows */}
              {memory.data.images.length > 1 && (
                <>
                  <button class="carousel-prev absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-background/20 backdrop-blur-md border border-white/10 text-white flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 transition-all duration-300 hover:bg-background/40 z-20" aria-label="Previous image">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                  </button>
                  <button class="carousel-next absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-background/20 backdrop-blur-md border border-white/10 text-white flex items-center justify-center opacity-0 group-hover/carousel:opacity-100 transition-all duration-300 hover:bg-background/40 z-20" aria-label="Next image">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                  </button>
                </>
              )}
              
              {/* Indicators */}
              {memory.data.images.length > 1 && (
                <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-1.5 px-2.5 py-1.5 rounded-full bg-black/30 backdrop-blur-md border border-white/10 z-10 transition-all duration-300 shadow-lg">
                  {memory.data.images.map((_, i) => (
                    <div class="carousel-dot w-1.5 h-1.5 rounded-full bg-white/30 transition-all duration-500" data-index={i}></div>
                  ))}
                </div>
              )}
            </div>
          )}

          <div class="text-xl text-foreground/70 leading-relaxed font-light space-y-4">
             <memory.Content />
          </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <style>
    #atlas-feed::-webkit-scrollbar {
      width: 4px;
    }
    #atlas-feed::-webkit-scrollbar-thumb {
      background-color: var(--color-border);
      border-radius: 9999px;
    }
    
    .atlas-card.active {
      opacity: 1;
      filter: grayscale(0);
      transform: scale(1);
    }

    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .carousel-dot.active {
      background-color: white;
      width: 1.5rem;
    }
    #atlas-subtitle {
    transition: opacity 0.3s ease-in-out;
  }
</style>

  <!-- D3 Dependencies -->
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <script src="https://unpkg.com/topojson-client@3"></script>
  
  <script is:inline>
    // Variables declared in outer scope to be shared
    let state = {
      width: 500,
      height: 500,
      sensitivity: 75,
      world: null,
      currentRotation: [0, -30],
      pins: [],
      activePinId: null,
      isInteracting: false,
      canvas: null,
      container: null,
      context: null,
      projection: null,
      path: null
    };

    function draw() {
      if (!state.world || !state.context) return;
      
      const theme = document.documentElement.getAttribute('data-theme') || 
                    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const isLight = theme === 'light';

      // High-Contrast Theme Palettes
      const colors = isLight ? {
        sphere: "rgba(240, 244, 255, 0.8)", // Light Blue Tinted Sphere
        land: "rgba(33, 115, 243, 0.3)",   // Vibrant Blue Continents
        graticule: "rgba(33, 39, 55, 0.08)", // Darker Grid
        border: "rgba(33, 115, 243, 0.2)",
        pin: "rgba(33, 115, 243, 0.6)",    // Solid Blue Pin (Inactive)
        pinActive: "#2196f3",               // Bright Blue Active Pin
        glow: "rgba(33, 150, 243, 0.5)"
      } : {
        sphere: "rgba(33, 39, 55, 0.6)", // Indigo Water
        land: "rgba(255, 107, 1, 0.2)",  // Orange Land
        graticule: "rgba(255, 255, 255, 0.05)",
        border: "rgba(255, 255, 255, 0.1)",
        pin: "rgba(255, 107, 1, 0.6)",
        pinActive: "#ff6b01", // Solid Orange Pin
        glow: "#ff6b01"
      };

      const land = topojson.feature(state.world, state.world.objects.countries);
      state.context.clearRect(0, 0, state.width, state.height);

      // Sphere (Water/Base)
      state.context.beginPath();
      state.context.arc(state.width / 2, state.height / 2, state.projection.scale(), 0, 2 * Math.PI);
      state.context.fillStyle = colors.sphere; 
      state.context.fill();

      // Land
      state.context.beginPath();
      state.path(land);
      state.context.fillStyle = colors.land; 
      state.context.fill();
      
      // Graticule (Grid lines)
      state.context.beginPath();
      state.path(d3.geoGraticule()());
      state.context.strokeStyle = colors.graticule;
      state.context.lineWidth = 0.5;
      state.context.stroke();

      // Sphere Border
      state.context.beginPath();
      state.context.arc(state.width / 2, state.height / 2, state.projection.scale(), 0, 2 * Math.PI);
      state.context.strokeStyle = colors.border;
      state.context.lineWidth = 1;
      state.context.stroke();

      // Pins
      state.pins.forEach(pin => {
        const coords = state.projection([pin.lng, pin.lat]);
        const gdistance = d3.geoDistance([pin.lng, pin.lat], state.projection.invert([state.width/2, state.height/2]));
        
        if (gdistance < Math.PI / 2) {
          const isActive = pin.id === state.activePinId;
          state.context.beginPath();
          state.context.arc(coords[0], coords[1], isActive ? 10 : 4, 0, 2 * Math.PI);
          state.context.fillStyle = isActive ? colors.pinActive : colors.pin;
          
          if (isActive) {
            state.context.shadowBlur = 25;
            state.context.shadowColor = colors.glow;
          }
          
          state.context.fill();
          state.context.shadowBlur = 0;
          
          if (isActive) {
            state.context.beginPath();
            state.context.arc(coords[0], coords[1], 16, 0, 2 * Math.PI);
            state.context.strokeStyle = isLight ? "rgba(33, 150, 243, 0.3)" : "rgba(255, 107, 1, 0.3)";
            state.context.lineWidth = 2;
            state.context.stroke();
          }
        }
      });
    }

    function resize() {
      if (!state.container || !state.canvas || !state.context) return;
      
      const rect = state.container.getBoundingClientRect();
      state.width = rect.width;
      state.height = rect.height;
      state.canvas.width = state.width * devicePixelRatio;
      state.canvas.height = state.height * devicePixelRatio;
      state.context.scale(devicePixelRatio, devicePixelRatio);
      
      state.projection.translate([state.width / 2, state.height / 2])
                      .scale(state.width / 2.1);
      draw();
    }

    async function initGlobe() {
      state.canvas = document.getElementById("globe-canvas");
      state.container = document.getElementById("globe-container");
      
      if (!state.canvas || !state.container) {
        console.warn("Globe elements not found, retrying...");
        setTimeout(initGlobe, 100);
        return;
      }

      state.context = state.canvas.getContext("2d");
      state.projection = d3.geoOrthographic();
      state.path = d3.geoPath(state.projection, state.context);

      try {
        state.world = await d3.json("https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json");
        const cards = document.querySelectorAll(".atlas-card");
        state.pins = Array.from(cards).map(card => ({
          lat: parseFloat(card.dataset.lat),
          lng: parseFloat(card.dataset.lng),
          id: card.id
        }));

        window.addEventListener("resize", resize);
        
        // WATCH FOR THEME CHANGES
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.attributeName === 'data-theme' || mutation.attributeName === 'class') {
              draw();
            }
          });
        });
        observer.observe(document.documentElement, { attributes: true });

        resize();
        setupInteractions();
        setupScrollSync();
        
        // Show canvas
        state.canvas.classList.remove("opacity-0");
        state.canvas.classList.add("opacity-100");

        draw();
        
        d3.timer((elapsed) => {
          if (!state.isInteracting && !state.activePinId) {
            state.projection.rotate([state.currentRotation[0] + elapsed * 0.005, state.currentRotation[1]]);
            draw();
          }
        });
      } catch (e) {
        console.error("Globe failed to init:", e);
      }
    }

    function setupInteractions() {
      d3.select(state.canvas).call(d3.drag()
        .on("start", () => state.isInteracting = true)
        .on("drag", (event) => {
          const rotate = state.projection.rotate();
          const k = state.sensitivity / state.projection.scale();
          state.projection.rotate([rotate[0] + event.dx * k, rotate[1] - event.dy * k]);
          state.currentRotation = state.projection.rotate();
          draw();
        })
        .on("end", () => state.isInteracting = false)
      );
    }

    function setupScrollSync() {
      const feed = document.getElementById("atlas-feed");
      const cards = document.querySelectorAll(".atlas-card");
      const subtitle = document.getElementById("atlas-subtitle");
      const yearGroups = document.querySelectorAll(".year-group");

      if (!feed) return;

      feed.addEventListener("scroll", () => {
        const feedRect = feed.getBoundingClientRect();
        
        // 1. Dynamic Title Sync (Option 1)
        let activeYear = "Global";
        yearGroups.forEach(group => {
          const rect = group.getBoundingClientRect();
          // If the year group has entered the viewport or is currently crossing the top
          if (rect.top < feedRect.top + 250 && rect.bottom > feedRect.top + 50) {
            activeYear = group.dataset.year;
          }
        });

        if (subtitle) {
          const targetText = `Archive // ${activeYear}`;
          if (subtitle.textContent !== targetText) {
            subtitle.style.opacity = "0";
            setTimeout(() => {
              subtitle.textContent = targetText;
              subtitle.style.opacity = "1";
            }, 200);
          }
        }

        // 2. Globe Rotation Sync
        const feedCenter = feedRect.top + feedRect.height / 2;
        
        let mostCentral = null;
        let minDistance = Infinity;

        cards.forEach(card => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.top + cardRect.height / 2;
          const distance = Math.abs(cardCenter - feedCenter);
          
          if (distance < minDistance) {
            minDistance = distance;
            mostCentral = card;
          }
        });

        if (mostCentral && (mostCentral.id !== state.activePinId)) {
          state.activePinId = mostCentral.id;
          cards.forEach(c => c.classList.remove("active"));
          mostCentral.classList.add("active");
          
          const targetLat = parseFloat(mostCentral.dataset.lat);
          const targetLng = parseFloat(mostCentral.dataset.lng);
          
          if (!state.isInteracting) {
            d3.transition()
              .duration(1200)
              .tween("rotate", () => {
                const r = d3.interpolate(state.projection.rotate(), [-targetLng, -targetLat]);
                return (t) => {
                  state.projection.rotate(r(t));
                  draw();
                };
              });
          }
        }
      });
      feed.dispatchEvent(new Event('scroll'));
    }

    function initCarousels() {
      const carousels = document.querySelectorAll(".carousel-container");
      
      carousels.forEach(container => {
        const wrapper = container.querySelector(".carousel-wrapper");
        const dots = container.querySelectorAll(".carousel-dot");
        const prevBtn = container.querySelector(".carousel-prev");
        const nextBtn = container.querySelector(".carousel-next");
        
        if (!wrapper || dots.length === 0) return;

        const handleScroll = () => {
          const scrollLeft = wrapper.scrollLeft;
          const width = wrapper.clientWidth;
          const index = Math.round(scrollLeft / width);
          
          dots.forEach((dot, i) => {
            if (i === index) {
              dot.classList.add("active");
            } else {
              dot.classList.remove("active");
            }
          });
        };

        if (prevBtn) {
          prevBtn.addEventListener("click", () => {
            wrapper.scrollBy({ left: -wrapper.clientWidth, behavior: 'smooth' });
          });
        }
        
        if (nextBtn) {
          nextBtn.addEventListener("click", () => {
            wrapper.scrollBy({ left: wrapper.clientWidth, behavior: 'smooth' });
          });
        }

        wrapper.addEventListener("scroll", handleScroll);
        // Initial state
        handleScroll();
      });
    }

    // Run on load and after transitions
    function init() {
      initGlobe();
      initCarousels();
    }

    document.addEventListener("astro:page-load", init);
    if (document.readyState === 'complete') {
      init();
    } else {
      window.addEventListener('load', init);
    }
  </script>
</Layout>
