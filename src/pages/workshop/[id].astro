---
import { type CollectionEntry, getCollection, render } from "astro:content";
import WorkshopDetails from "@/layouts/WorkshopDetails.astro";

type Props = {
  item: CollectionEntry<"workshop">;
};

export async function getStaticPaths() {
  const workshopItems = await getCollection("workshop", ({ data }) => !data.draft);
  return workshopItems.map(item => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<WorkshopDetails item={item} />
