  function handleCommand(raw) {
    const trimmed = raw.trim();
    if (!trimmed && !contactState) return;

    // Contact State Machine Handling
    /* if (contactState) {
      if (trimmed.toLowerCase() === 'exit' || trimmed.toLowerCase() === 'quit') {
        addLine('Messaging aborted.', 'term-dim opacity-40 mt-1');
        contactState = null;
        contactData = { name: '', email: '', message: '' };
        setPrompt(DEFAULT_PROMPT);
        return;
      }

      addLine(trimmed, 'term-main font-bold mb-2');
      
      if (contactState === 'name') {
        contactData.name = trimmed;
        contactState = 'email';
        setPrompt('<span class="text-accent font-mono font-bold">Email > </span>');
      } else if (contactState === 'email') {
        contactData.email = trimmed;
        contactState = 'message';
        setPrompt('<span class="text-accent font-mono font-bold">Message > </span>');
      } else if (contactState === 'message') {
        contactData.message = trimmed;
        addLine('Sending message...', 'text-accent mt-2');
        setPrompt(DEFAULT_PROMPT);
        
        setTimeout(() => {
          addLine('<span class="text-green-400 font-bold">✓ Message encrypted and sent successfully.</span>', 'mt-1 mb-4');
          addLine(`[SESSION LOG]: Message from ${contactData.name} (${contactData.email}) queued for delivery.`, 'term-dim italic opacity-40 text-[10px]');
          contactState = null;
          contactData = { name: '', email: '', message: '' };
        }, 1500);
      }
      return;
    } */
    
    if (!trimmed) return;
    
    history.push(trimmed);
    historyIndex = history.length;
    
    addLine(trimmed, 'prompt-echo');
    
    const [cmdName, ...args] = trimmed.toLowerCase().split(' ');
    
    if (COMMANDS[cmdName]) {
      COMMANDS[cmdName].fn(args);
    } else {
      addLine(`Command not found: ${cmdName}. Type <span class="text-accent font-bold cursor-pointer" onclick="document.getElementById('terminal-input').value='help'; document.getElementById('terminal-input').dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter'}))">help</span> to see available commands.`, 'text-red-400');
    }
  }

  // Input listeners
  function handleInput(e) {
    if (e.key === 'Enter') {
      const val = input.value;
      input.value = '';
      handleCommand(val);
      popup.classList.add('hidden');
    }
    
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (historyIndex > 0) {
        historyIndex--;
        input.value = history[historyIndex];
      }
    }
    
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIndex < history.length - 1) {
        historyIndex++;
        input.value = history[historyIndex];
      } else {
        historyIndex = history.length;
        input.value = '';
      }
    }

    if (e.key === 'Tab') {
      e.preventDefault();
      const val = input.value.toLowerCase();
      if (!val) return;
      
      const matches = Object.keys(COMMANDS).filter(c => c.startsWith(val));
      if (matches.length === 1) {
        input.value = matches[0];
      } else if (matches.length > 1) {
        // Show popup
        popup.innerHTML = matches.map(m => `<div class="p-2 hover:bg-accent/20 cursor-pointer text-white border-b border-white/5 last:border-0">${m}</div>`).join('');
        popup.classList.remove('hidden');
      }
    }
  }

  // Autocomplete popup click
  function handlePopupClick(e) {
    if (e.target.innerText) {
      input.value = e.target.innerText;
      popup.classList.add('hidden');
      input.focus();
    }
  }

    // Fixed: Redundant listener removed. Focus handled in initTerminal.

  // Boot Sequence
  async function boot() {
    input.disabled = true;
    const lines = [
      { t: "Establishing secure connection to portfolio...", d: 100 },
      { t: "Mounting shannon_dussoye_kernel...", d: 400 },
      { t: "Loading data modules: experience, skills, blog...", d: 700 },
      { t: "System initialized. Welcome to Shannon's terminal.", d: 1100, type: 'text-accent font-bold' },
      { t: "--------------------------------------------------", d: 1200, type: 'term-dim opacity-20' },
      { t: "Type 'help' to get started.", d: 1300, type: 'term-dim' },
      { t: "", d: 1400 }
    ];

    for (const line of lines) {
      await new Promise(r => setTimeout(r, line.d));
      addLine(line.t, line.type || 'term-main opacity-80');
    }

    // Render Identity immediately as part of the session start
    await new Promise(r => setTimeout(r, 400));
    COMMANDS.whoami.fn();
    addLine('<span class="term-dim">Type </span><span class="text-accent font-bold cursor-pointer" onclick="document.getElementById(\'terminal-input\').value=\'help\'; document.getElementById(\'terminal-input\').dispatchEvent(new KeyboardEvent(\'keydown\', {key: \'Enter\'}))">help</span><span class="term-dim"> to explore more commands.</span>', 'mt-2 mb-4');

    // Finally show the prompt and allow input
    inputRow.classList.remove('op-0', 'pointer-events-none');
    inputRow.classList.add('op-1');
    input.disabled = false;
    input.focus();
  }

  // Dynamic Uptime & Latency
  function startStats() {
    let startTime = Date.now();
    uptimeInterval = setInterval(() => {
      const uptime = Math.floor((Date.now() - startTime) / 1000);
      const h = Math.floor(uptime / 3600).toString().padStart(2, '0');
      const m = Math.floor((uptime % 3600) / 60).toString().padStart(2, '0');
      const s = (uptime % 60).toString().padStart(2, '0');
      const uptimeEl = document.getElementById('uptime-val');
      if (uptimeEl) uptimeEl.textContent = `${h}:${m}:${s}`;
      
      if (Math.random() > 0.8) {
        const latencyEl = document.getElementById('latency-val');
        if (latencyEl) latencyEl.textContent = `${Math.floor(Math.random() * 20) + 15}ms`;
      }
    }, 1000);
  }

  // Initial Load & Astro View Transitions
  initTerminal();
  document.addEventListener('astro:after-swap', initTerminal);
</script>
