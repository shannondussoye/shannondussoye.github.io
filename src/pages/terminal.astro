    matrix: {
      desc: "🐇 Wake up, Neo",
      fn: () => {
        const canvas = document.getElementById('matrix-canvas');
        canvas.classList.remove('hidden');
        const ctx = canvas.getContext('2d');
        canvas.width = canvas.parentElement.offsetWidth;
        canvas.height = canvas.parentElement.offsetHeight;
        
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$+-*/=%\"\'#&_(),.;:?!\\|{}<>[]^~";
        const fontSize = 14;
        const columns = canvas.width / fontSize;
        const drops = Array.from({ length: columns }).fill(1);
        
        const interval = setInterval(() => {
          ctx.fillStyle = "rgba(13, 14, 18, 0.05)";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
          ctx.fillStyle = accentColor || "#ff6b01";
          ctx.font = fontSize + "px monospace";
          
          for (let i = 0; i < drops.length; i++) {
            const text = chars.charAt(Math.floor(Math.random() * chars.length));
            ctx.fillText(text, i * fontSize, drops[i] * fontSize);
            if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
            drops[i]++;
          }
        }, 33);
        
        addLine('Matrix protocol initiated...', 'text-accent');
        addLine('Press any key to exit.', 'term-dim opacity-60');
        
        const stopMatrix = (e) => {
          // Prevent the Enter key that started the command from immediately stopping it
          if (e.key === 'Enter') return;
          
          clearInterval(interval);
          canvas.classList.add('hidden');
          window.removeEventListener('keydown', stopMatrix);
        };
        // Use a small timeout to ensure the Enter key event has finished bubbling
        setTimeout(() => {
          window.addEventListener('keydown', stopMatrix);
        }, 100);
      }
    },
