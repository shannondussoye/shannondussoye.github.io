---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
// @ts-ignore
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

// 1. Fetch single source of truth from resume.md
import { getCollection } from "astro:content";
const resumeDocs = await getCollection("resume");
const resumeEntry = resumeDocs[0];

if (!resumeEntry) {
  throw new Error("Could not find any entries in the 'resume' collection. Check src/data/resume.md");
}

const { data: resumeData, body } = resumeEntry;

// 2. Prepare data for client-side use
const SHANNON = {
  ...resumeData,
  summary: body // The Markdown body becomes the summary
};

const SOCIALS = resumeData.socials;
const workExperience = resumeData.work_experience;

const title = "shannon@terminal";
---

<Layout title={`${title} | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout terminal-page flex flex-col h-[calc(100vh-6rem)] pt-2 pb-4 overflow-hidden relative">
    
    <!-- Decorative Status Bar -->
    <div class="w-full mb-4 flex-none grid grid-cols-2 sm:grid-cols-4 gap-4 px-2 opacity-60">
      <div class="border-l-2 border-accent pl-2">
        <div class="text-[9px] font-black uppercase tracking-widest text-dim">Connection</div>
        <div class="text-[11px] font-mono text-main">SHANNON-TERMINAL-01</div>
      </div>
      <div class="border-l-2 border-accent/30 pl-2">
        <div class="text-[9px] font-black uppercase tracking-widest text-dim">Status</div>
        <div class="flex items-center gap-1.5 text-[11px] font-mono text-main">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
          ENCRYPTED
        </div>
      </div>
      <div class="border-l-2 border-accent/30 pl-2 hidden sm:block">
        <div class="text-[9px] font-black uppercase tracking-widest text-dim">Latency</div>
        <div class="text-[11px] font-mono text-main" id="latency-val">24ms</div>
      </div>
      <div class="border-l-2 border-accent/30 pl-2 hidden sm:block">
        <div class="text-[9px] font-black uppercase tracking-widest text-dim">Uptime</div>
        <div class="text-[11px] font-mono text-main" id="uptime-val">00:00:00</div>
      </div>
    </div>

    <!-- Top Decorative Header -->
    <div class="w-full mb-4 flex-none flex items-baseline justify-between gap-4 border-b border-white/5 pb-6">
      <div class="flex flex-col">
        <h1 class="text-3xl font-black uppercase tracking-tighter italic text-main strike-offset">Terminal Session</h1>
        <div class="text-[10px] font-mono text-dim uppercase tracking-[0.2em] mt-1">Interactive Resume & Dashboard</div>
      </div>
      
      <div class="hidden sm:block text-[10px] font-mono text-accent/60 leading-none text-right">
        v2026.03.12<br/>
        AUTH_LEVEL: ROOT
      </div>
    </div>

    <!-- Main Terminal Window Container -->
    <div class="w-full flex-1 min-h-0 flex flex-col">
      <div id="terminal-window" class="terminal-container shadow-2xl overflow-hidden glassmorphism border border-white/10 relative w-full h-full">
        <div class="terminal-header flex-none flex items-center justify-between px-4 py-2 border-b border-white/10 bg-white/5 select-none">
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-[#ff5f57] cursor-pointer hover:opacity-80 transition-opacity"></div>
            <div class="w-3 h-3 rounded-full bg-[#febc2e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#28c840]"></div>
          </div>
          <div class="text-[10px] uppercase tracking-widest text-white/40 font-bold">shannon@portfolio — terminal</div>
          <div class="w-12"></div>
        </div>
        
        <div id="terminal-output" class="p-6 overflow-y-auto font-mono text-sm leading-relaxed custom-scrollbar relative z-10 scroll-smooth flex-1">
          <div id="terminal-content"></div>
          <div id="terminal-input-row" class="mt-2 flex items-center gap-2 op-0 pointer-events-none transition-opacity duration-300">
            <span class="prompt-text whitespace-nowrap" id="terminal-prompt">
              <span class="text-accent font-bold">shannon</span><span class="term-dim opacity-40">@</span><span class="text-blue-400">portfolio</span><span class="term-main opacity-60">:</span><span class="text-purple-400">~</span><span class="text-accent/80">$</span>
            </span>
            <input 
              id="terminal-input" 
              type="text" 
              class="bg-transparent border-none outline-none term-main w-full font-mono caret-accent" 
              autocomplete="off" 
              spellcheck="false" 
              autofocus
            />
          </div>
        </div>
        <div id="scroll-progress" class="no-print"></div>

        <div id="autocomplete-popup" class="hidden absolute bottom-20 left-6 right-6 bg-background/90 backdrop-blur-md border border-border rounded-xl overflow-hidden z-30 shadow-2xl">
          <!-- Autocomplete items -->
        </div>

        <canvas id="matrix-canvas" class="hidden absolute inset-0 pointer-events-none z-1 rounded-2xl"></canvas>
        
        <!-- CRT Overlay Effects -->
        <div class="crt-overlay pointer-events-none absolute inset-0 z-20 overflow-hidden opacity-5 underline-none">
          <div class="scanlines"></div>
          <div class="flicker"></div>
        </div>
      </div>
    </div>

    <!-- Bottom Dashboard Toolbar -->
    <div class="w-full flex-none grid grid-cols-1 md:grid-cols-4 gap-4 mt-6">
      <!-- Command Quick Links -->
      <div class="md:col-span-3 glassmorphism border border-border/50 p-4 rounded-2xl">
        <div class="text-[10px] font-black uppercase tracking-[0.2em] text-accent mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          Quick Access
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          {[
            { cmd: 'resume', desc: 'Summary' },
            { cmd: 'skills', desc: 'Stack' },
            { cmd: 'experience', desc: 'Work' },
            { cmd: 'pulse', desc: 'Live' },
            { cmd: 'matrix', desc: 'Glitch' }
          ].map(item => (
            <div 
              class="group cursor-pointer flex flex-col p-2 rounded-xl hover:bg-accent/5 transition-all border border-transparent hover:border-accent/20"
              onclick={`document.getElementById('terminal-input').value='${item.cmd}'; document.getElementById('terminal-input').dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter'}))`}
            >
              <div class="text-xs font-mono term-main group-hover:text-accent transition-colors flex justify-between items-baseline">
                <span>{item.cmd}</span>
                <span class="text-[8px] opacity-0 group-hover:opacity-40 transition-opacity italic">↵</span>
              </div>
              <div class="text-[9px] term-dim uppercase tracking-tighter mt-1">{item.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Shortcuts Pad -->
      <div class="glassmorphism border border-border/50 p-4 rounded-2xl flex flex-col justify-center">
        <div class="text-[10px] font-black uppercase tracking-[0.2em] term-dim mb-3 text-center">System Shortcuts</div>
        <div class="grid grid-cols-2 gap-y-2 text-[10px] font-mono">
          <div class="term-dim/60 font-bold">TAB</div><div class="term-main/80 text-right">Auto-fill</div>
          <div class="term-dim/60 font-bold">↑ / ↓</div><div class="term-main/80 text-right">History</div>
          <div class="term-dim/60 font-bold">CTR+L</div><div class="term-main/80 text-right">Clear</div>
        </div>
      </div>
    </div>

    <!-- Pinned Footer -->
    <div class="mt-4 flex-none no-print">
      <Footer />
    </div>
  </main>
</Layout>

<style>
  :root {
    --term-bg: rgba(253, 253, 253, 0.98);
    --term-text: #282728;
    --term-dim: rgba(40, 39, 40, 0.4);
    --term-border: rgba(40, 39, 40, 0.1);
  }

  :global([data-theme="dark"]) {
    --term-bg: rgba(13, 14, 18, 0.98);
    --term-text: #eaedf3;
    --term-dim: rgba(234, 237, 243, 0.4);
    --term-border: rgba(234, 237, 243, 0.1);
  }

  :global(body) {
    overflow-x: hidden;
  }

  .terminal-page {
    background-image: radial-gradient(var(--border) 0.5px, transparent 0.5px);
    background-size: 24px 24px;
    background-position: center top;
  }

  .terminal-container {
    width: 100%;
    flex: 1; /* Grow to fill viewport gap */
    background: var(--term-bg);
    border-radius: 1.25rem;
    border: 1px solid var(--term-border);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--term-text);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Dark mode specific terminal adjustment */
  :global([data-theme="dark"]) .terminal-container {
    border-color: color-mix(in srgb, var(--accent), transparent 60%);
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent), transparent 90%);
  }

  .glassmorphism {
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  .text-accent {
    color: var(--accent);
  }

  .term-main { color: var(--term-text); }
  .term-dim { color: var(--term-dim); }

  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--accent), transparent 70%);
    border-radius: 10px;
    border: 1px solid transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  /* Reading Progress Line */
  #scroll-progress {
    position: absolute;
    left: 0;
    top: 44px; /* Just below the terminal header */
    width: 100%;
    height: 2px;
    background: var(--accent);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.1s linear, opacity 0.3s ease;
    z-index: 50;
    box-shadow: 0 0 8px var(--accent);
  }

  /* CRT Effects */
  .crt-overlay {
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), 
                linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
    background-size: 100% 2px, 3px 100%;
  }

  .scanlines {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, .1) 51%);
    background-size: 100% 4px;
    animation: scanlines 0.2s linear infinite;
  }

  @keyframes scanlines {
    0% { transform: translateY(0); }
    100% { transform: translateY(4px); }
  }

  .flicker {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(18, 16, 16, 0.03);
    animation: flicker 0.1s infinite;
  }

  @keyframes flicker {
    0% { opacity: 0.1; }
    50% { opacity: 0.2; }
    100% { opacity: 0.1; }
  }

  .op-0 { opacity: 0; }
  .op-1 { opacity: 1; }

  /* Animation for lines */
  .terminal-line {
    animation: fadeIn 0.3s ease-out forwards;
    opacity: 0;
    transform: translateY(5px);
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tags */
  .tag {
    display: inline-block;
    padding: 0 0.5rem;
    font-size: 0.7rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent), transparent 90%);
    color: var(--accent);
    margin-right: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent), transparent 80%);
  }

  .skill-bar-bg {
    height: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    overflow: hidden;
    width: 200px;
    display: inline-block;
    vertical-align: middle;
    margin: 0 10px;
  }

  .skill-bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 4px;
    width: 0;
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fillBar {
    from { width: 0; }
  }
  .animate-fill {
    animation: fillBar 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script is:inline define:vars={{ SOCIALS, SHANNON, workExperience }}>
  // 2. Prepare data for client-side use
  const processedCompetencies = SHANNON.core_competencies.map(comp => {
    const parts = comp.split(':');
    const category = parts[0] ? parts[0].trim() : "Other";
    const skillsString = parts[1] ? parts[1].trim() : "";
    const skills = skillsString.split('•').map(s => s.trim()).filter(Boolean);
    return { category, skills };
  });

  const SHANNON_CLIENT = {
    ...SHANNON,
    core_competencies: processedCompetencies
  };

  // Data for the terminal
  let pulseFeed = [];
  let workExperienceData = SHANNON.work_experience;

  // Contact state machine
  let contactState = null; // null, 'name', 'email', 'message'

  // Fetch blog posts once per full session
  async function fetchFeeds() {
    try {
      // 1. Fetch RSS feeds
      const rssRes = await fetch('/rss.xml');
      const xml = await rssRes.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(xml, "text/xml");
      const items = doc.querySelectorAll("item");
      
      const allItems = Array.from(items).map(item => {
        const fullTitle = item.querySelector("title").textContent;
        const category = item.querySelector("category")?.textContent;
        return {
          title: fullTitle,
          displayDate: new Date(item.querySelector("pubDate").textContent).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }),
          recommendation: item.querySelector("description")?.textContent.replace(/<[^>]*>/g, '').substring(0, 100),
          link: item.querySelector("link").textContent,
          category: category
        };
      });

      // Filter for pulse command (latest 3)
      pulseFeed = allItems.slice(0, 3);

      // Removed: 2. Fetch Curated Projects (now passed via define:vars)
    } catch (e) {
      console.error('Terminal Data Error:', e);
    }
  }

  // SHANNON object is now passed via define:vars, no longer hardcoded here.
  // SOCIALS object is now passed via define:vars, no longer hardcoded here.

  let output, input, inputRow, popup;
  let history = [];
  let historyIndex = -1;
  let uptimeInterval, latencyInterval;

  function initTerminal() {
    output = document.getElementById('terminal-output');
    input = document.getElementById('terminal-input');
    inputRow = document.getElementById('terminal-input-row');
    popup = document.getElementById('autocomplete-popup');
    
    if (!output || !input) return;

    // Clear existing intervals
    if (uptimeInterval) clearInterval(uptimeInterval);
    if (latencyInterval) clearInterval(latencyInterval);

    history = [];
    historyIndex = -1;

    // Re-attach listeners
    input.addEventListener('keydown', handleInput);
    popup.addEventListener('click', handlePopupClick);
    
    // Focus management that doesn't jump on interactive clicks
    const focusListener = (e) => {
      const target = e.target;
      if (target && typeof target.closest === 'function') {
        const isInteractive = target.closest('button, a, input, [onclick], .no-focus-trigger');
        if (!isInteractive) {
          input.focus({ preventScroll: true });
        }
      } else if (!target) {
        input.focus({ preventScroll: true });
      }
    };
    
    // Use a named function for easier cleanup/management
    document.removeEventListener('click', focusListener); // Safety
    document.addEventListener('click', focusListener);
    
    // Add scroll tracking once
    output.removeEventListener('scroll', handleScrollUpdate); // Safety
    output.addEventListener('scroll', handleScrollUpdate);
    
    const closeBtn = document.querySelector('.bg-\\[\\#ff5f57\\]');
    if (closeBtn) {
      closeBtn.onclick = () => COMMANDS.exit.fn();
    }

    fetchFeeds();
    boot();
    startStats();
  }

  // Render Helpers
  function addLine(text, type = 'default', autoScroll = true, delay = 0) {
    const div = document.createElement('div');
    const content = document.getElementById('terminal-content');
    div.className = `terminal-line mb-1 ${type}`;
    
    if (type === 'prompt-echo') {
      div.innerHTML = `<span class="text-accent font-bold">shannon</span><span class="term-dim opacity-40">@</span><span class="text-blue-400">portfolio</span><span class="term-main opacity-60">:</span><span class="text-purple-400">~</span><span class="text-accent/80">$</span> <span class="term-main font-bold">${text}</span>`;
    } else {
      div.innerHTML = text;
    }
    
    if (delay > 0) {
      setTimeout(() => {
        content.appendChild(div);
        if (autoScroll) output.scrollTop = output.scrollHeight;
      }, delay);
    } else {
      content.appendChild(div);
      if (autoScroll) output.scrollTop = output.scrollHeight;
    }

    return div;
  }

  function handleScrollUpdate() {
    const progress = output.scrollTop / (output.scrollHeight - output.clientHeight);
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      progressBar.style.opacity = progress > 0.01 ? '1' : '0';
      progressBar.style.transform = `scaleX(${progress})`;
    }
  }

  function clear() {
    document.getElementById('terminal-content').innerHTML = '';
  }

  // Simple Markdown Parser for Terminal Session
  function parseMarkdown(md) {
    if (!md) return '';
    
    // 1. Process block elements
    let html = md
      // Headers
      .replace(/^# (.*$)/gm, '<h1 class="text-3xl font-black text-main uppercase italic mb-4 mt-6 selection:bg-accent">$1</h1>')
      .replace(/^## (.*$)/gm, '<h2 class="text-xl font-black text-accent uppercase tracking-tighter mb-1 mt-4 flex items-center gap-2"><span class="opacity-40">//</span> $1</h2>')
      // Lists (unordered)
      .replace(/^\- (.*$)/gm, '<div class="flex gap-3 mb-2 ml-4 selection:bg-accent selection:text-white"><span class="text-accent ring-1 ring-accent/30 w-1 h-1 rounded-full mt-2 flex-none"></span><span class="term-main opacity-80">$1</span></div>');

    // 2. Process inline elements
    html = html
      // Bold
      .replace(/\*\*(.*?)\*\*/g, '<b class="text-accent font-bold">$1</b>')
      // Italic
      .replace(/\*(.*?)\*/g, '<i class="italic opacity-80">$1</i>')
      // Links
      .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" class="text-blue-400 underline underline-offset-4 decoration-current/30 hover:text-accent hover:decoration-accent transition-all">$1</a>');

    // 3. Final cleanup: wrap loose text blocks in paragraphs
    return html.split('\n\n').map(p => {
      p = p.trim();
      if (!p) return '';
      // If it already looks like a block element, don't wrap in <p>
      if (p.startsWith('<h') || p.startsWith('<div')) return p;
      return `<p class="mb-5 leading-relaxed opacity-90">${p}</p>`;
    }).filter(Boolean).join('');
  }

  // Toggle Function for Experience Details
  window.toggleDetails = (id, btn, event) => {
    if (event) event.stopPropagation();
    const el = document.getElementById(id);
    if (!el) return;
    const isHidden = el.classList.contains('hidden');
    el.classList.toggle('hidden');
    
    if (isHidden) {
      btn.innerHTML = '<span class="text-accent ring-1 ring-accent/30 px-2 py-0.5 rounded text-[10px] items-center gap-1 group/btn ml-1 hover:bg-accent/10 transition-colors inline-flex"><span class="w-1 h-1 rounded-full bg-accent"></span> HIDE DETAILS</span>';
    } else {
      btn.innerHTML = '<span class="text-accent/60 ring-1 ring-accent/20 px-2 py-0.5 rounded text-[10px] items-center gap-1 group/btn ml-1 hover:bg-accent/10 transition-colors inline-flex"><span class="w-1 h-1 rounded-full bg-accent/40"></span> SHOW DETAILS</span>';
    }
  };

  // Commands
  const COMMANDS = {
    help: {
      desc: "Show available commands",
      fn: (args) => {
        const showAll = args && args[0] === '--all';
        
        addLine('<span class="text-accent font-bold">CORE INTERFACE</span>', 'mb-2');
        Object.keys(COMMANDS).sort().forEach(cmd => {
          if (COMMANDS[cmd].hidden || cmd === 'help') return;
          addLine(`<span class="text-blue-400 w-24 inline-block font-bold">${cmd}</span> <span class="term-dim opacity-60">— ${COMMANDS[cmd].desc}</span>`);
        });
        
        // Add help itself at the end of core
        addLine(`<span class="text-blue-400 w-24 inline-block font-bold">help</span> <span class="term-dim opacity-60">— Show available commands</span>`);

        if (showAll) {
          addLine('<span class="text-purple-400 font-bold mt-4 block">// SYSTEM OVERRIDES (CLASSIFIED)</span>', 'mb-2');
          Object.keys(COMMANDS).sort().forEach(cmd => {
            if (!COMMANDS[cmd].hidden) return;
            addLine(`<span class="text-purple-300 w-24 inline-block font-bold opacity-60">${cmd}</span> <span class="term-dim opacity-40">— ${COMMANDS[cmd].desc}</span>`);
          });
        } else {
          addLine('<div class="mt-4 p-2 bg-accent/5 rounded border border-accent/10 text-[10px] term-dim flex justify-between items-center group cursor-pointer" onclick="document.getElementById(\'terminal-input\').value=\'help --all\'; document.getElementById(\'terminal-input\').dispatchEvent(new KeyboardEvent(\'keydown\', {key: \'Enter\'}))"><span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-accent/40 group-hover:bg-accent animate-pulse"></span> Classified system overrides detected...</span> <span class="opacity-0 group-hover:opacity-100 font-mono tracking-tighter transition-opacity text-accent">Type "help --all" to show</span></div>');
        }
        
        addLine('', 'mt-2 text-[10px] opacity-40 italic');
        addLine('Hint: Use "ls" and "cat" to explore the kernel filesystem.', 'term-dim');
      }
    },
    whoami: {
      hidden: true,
      desc: "Display identity card",
      fn: () => {
        addLine(`
<pre class="text-accent text-[10px] leading-tight mb-4">
  ██████╗ ██╗  ██╗ █████╗ ███╗   ██╗███╗   ██╗ ██████╗ ███╗   ██╗
  ██╔════╝ ██║  ██║██╔══██╗████╗  ██║████╗  ██║██╔═══██╗████╗  ██║
  ╚█████╗  ███████║███████║██╔██╗ ██║██╔██╗ ██║██║   ██║██╔██╗ ██║
  ╚═══██╗ ██╔══██║██╔══██║██║╚██╗██║██║╚██╗██║██║   ██║██║╚██╗██║
  ██████╔╝ ██║  ██║██║  ██║██║ ╚████║██║ ╚████║╚██████╔╝██║ ╚████║
  ╚═════╝  ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚═══╝ ╚═════╝ ╚═╝  ╚═══╝
</pre>
        `);
        addLine(`<span class="term-main font-bold text-lg">${SHANNON_CLIENT.name}</span>`);
        addLine(`<span class="term-main opacity-60">${SHANNON_CLIENT.role}</span>`);
        addLine(`<span class="term-dim">${SHANNON_CLIENT.location}</span>`, 'mb-4');
        addLine(`<span class="text-accent">Email:</span> <span class="term-main font-medium">${SHANNON_CLIENT.email}</span>`);
        addLine(`<span class="text-accent">GitHub:</span> <span class="term-main font-medium">${SHANNON_CLIENT.github}</span>`);
        addLine('', 'mt-2');
      }
    },
