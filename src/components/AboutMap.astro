---
---

<div id="map"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<style is:inline>
    #map {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 1;
        background: #262626; /* Match tile color */
    }

    /* Custom Marker Dot */
    .marker-dot-container {
        width: 16px;
        height: 16px;
        margin-left: -8px;
        margin-top: -8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.5s ease;
    }

    .marker-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid white;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        background-color: var(--marker-color);
    }

    /* Custom Popup Styling */
    .leaflet-popup-content-wrapper {
        background: rgba(15, 23, 42, 0.9) !important;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white !important;
        border-radius: 0.75rem !important;
    }

    .leaflet-popup-tip {
        background: rgba(15, 23, 42, 0.9) !important;
    }

    .popup-title {
        font-weight: 800;
        font-size: 1.125rem;
        margin-bottom: 0.25rem;
    }

    /* Hide Close Button */
    .leaflet-popup-close-button {
        display: none !important;
    }
</style>

<script is:inline>
    document.addEventListener('astro:page-load', () => {
        const mapEl = document.getElementById('map');
        if (!mapEl || mapEl._leaflet_id) return;

        // Initialize Map
        const map = L.map('map', {
            zoomControl: false,
            scrollWheelZoom: false,
            dragging: false,
            attributionControl: false
        }).setView([-20.4302, 57.6836], 9);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            maxZoom: 20
        }).addTo(map);

        const locs = {
            mauritius: [-20.4302, 57.6836],
            sydney: [-33.9461, 151.1770],
            uts: [-33.8838, 151.2002],
            techFX: [-33.8385818, 151.034588],
            equifax: [-33.8398565, 151.2070041],
            cba: [-33.874886, 151.200775],
            macquarie: [-33.8677, 151.2089]
        };

        function addMarker(latlng, color, title, visible = false) {
            const icon = L.divIcon({
                className: '',
                html: `
                    <div class="marker-dot-container" style="--marker-color: ${color}; opacity: ${visible ? 1 : 0}">
                        <div class="marker-dot"></div>
                    </div>
                `,
                iconSize: [0, 0]
            });

            const marker = L.marker(latlng, { icon: icon }).addTo(map);
            if (title) {
                marker.bindPopup(`<div class="popup-title" style="color: ${color}">${title}</div>`, { 
                    autoClose: false, 
                    closeOnClick: false, 
                    offset: [0, -5] 
                });
            }
            return marker;
        }

        const m_mauritius = addMarker(locs.mauritius, "#2dd4bf", "Mauritius", true);
        const m_sydney = addMarker(locs.sydney, "#3b82f6", "Sydney", false);
        const m_uts = addMarker(locs.uts, "#6366f1", "UTS", false);
        const m_techfx = addMarker(locs.techFX, "#f59e0b", "Technology FX", false);
        const m_equifax = addMarker(locs.equifax, "#ef4444", "Equifax", false);
        const m_cba = addMarker(locs.cba, "#f59e0b", "CBA", false);
        const m_macquarie = addMarker(locs.macquarie, "#94a3b8", "Macquarie", false);

        const allMarkers = [m_mauritius, m_sydney, m_uts, m_techfx, m_equifax, m_cba, m_macquarie];

        function setMarkerVisibility(index) {
            allMarkers.forEach((m, i) => {
                const element = m.getElement()?.querySelector('.marker-dot-container');
                let isVisible = (i <= index);
                if (i === 1 && index >= 2) isVisible = false;

                if (isVisible) {
                    if (element) element.style.opacity = '1';
                } else {
                    if (element) element.style.opacity = '0';
                    m.closePopup();
                }
            });
        }

        const flightPath = L.polyline([], {
            color: '#38bdf8',
            weight: 2,
            opacity: 0.8,
            dashArray: '5, 10'
        }).addTo(map);

        const planeIcon = L.divIcon({
            className: 'plane-icon',
            html: '<div style="font-size: 24px; transition: transform 0.3s; transform: rotate(45deg);">✈️</div>',
            iconSize: [30, 30],
            iconAnchor: [15, 15]
        });
        const planeMarker = L.marker(locs.mauritius, { icon: planeIcon, opacity: 0 }).addTo(map);

        let lastStep = null;
        let animationFrame = null;

        function animateFlight(isReverse = false) {
            if (animationFrame) cancelAnimationFrame(animationFrame);
            planeMarker.setOpacity(1);
            flightPath.setStyle({ opacity: 0.8 });
            let start = null;
            const duration = 3000;
            const startPt = isReverse ? locs.sydney : locs.mauritius;
            const endPt = isReverse ? locs.mauritius : locs.sydney;

            function step(timestamp) {
                if (!start) start = timestamp;
                const progress = Math.min((timestamp - start) / duration, 1);
                const lat = startPt[0] + (endPt[0] - startPt[0]) * progress;
                const lng = startPt[1] + (endPt[1] - startPt[1]) * progress;
                const currentPos = [lat, lng];
                planeMarker.setLatLng(currentPos);
                
                const angle = isReverse ? -135 : 45;
                const planeDiv = planeMarker.getElement()?.querySelector('div');
                if (planeDiv) planeDiv.style.transform = `rotate(${angle}deg)`;
                flightPath.setLatLngs([locs.mauritius, currentPos]);

                if (progress < 1) {
                    animationFrame = window.requestAnimationFrame(step);
                } else {
                    planeMarker.setOpacity(0);
                    if (!isReverse) {
                        flightPath.setStyle({ opacity: 0 });
                        map.flyTo(locs.sydney, 10, { duration: 3 });
                        const dotEl = m_sydney.getElement()?.querySelector('.marker-dot-container');
                        if (dotEl) dotEl.style.opacity = '1';
                    } else {
                        flightPath.setLatLngs([]);
                        setMarkerVisibility(0);
                        map.flyTo(locs.mauritius, 9, { duration: 2 });
                    }
                }
            }
            animationFrame = window.requestAnimationFrame(step);
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const step = +entry.target.getAttribute('data-step');
                    let direction = 'down';
                    let isInitial = false;
                    
                    if (lastStep === null) {
                        isInitial = true;
                    } else {
                        direction = step > lastStep ? 'down' : 'up';
                    }

                    document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
                    entry.target.classList.add('active');
                    allMarkers.forEach(m => m.closePopup());

                    if (step === 1 || step === 7) setMarkerVisibility(step);
                    if (step === 0 && (direction === 'down' || isInitial)) setMarkerVisibility(0);

                    const flyOpts = { duration: 3, easeLinearity: 0.1 };
                    const sydneyOverview = [-33.87, 151.15];
                    const sydneyZoom = 11;

                    if (step === 0) {
                        if (direction === 'up') {
                            map.flyToBounds([locs.mauritius, locs.sydney], { padding: [50, 50], duration: 2 });
                            setTimeout(() => animateFlight(true), 2100);
                        } else {
                            map.flyTo(locs.mauritius, 9, isInitial ? { duration: 0 } : flyOpts);
                            flightPath.setLatLngs([]); 
                            planeMarker.setOpacity(0);
                            setMarkerVisibility(0);
                        }
                    }

                    if (step === 1 && direction === 'down') {
                        map.flyToBounds([locs.mauritius, locs.sydney], { padding: [50, 50], duration: 3 });
                        setTimeout(() => animateFlight(false), 3200);
                    }

                    if (step === 2) {
                        map.flyTo(sydneyOverview, sydneyZoom, { duration: 3 });
                        setMarkerVisibility(step);
                        m_uts.openPopup();
                    }
                    
                    if (step > 2 && step < 7) {
                        if (step === 3) { 
                            map.flyTo(sydneyOverview, sydneyZoom, flyOpts); 
                            setMarkerVisibility(step); m_techfx.openPopup();
                        }
                        if (step === 4) { 
                            map.flyTo(sydneyOverview, sydneyZoom, flyOpts); 
                            setMarkerVisibility(step); m_equifax.openPopup();
                        }
                        if (step === 5) { 
                            map.flyTo(locs.cba, 15, flyOpts); 
                            setMarkerVisibility(step); m_cba.openPopup();
                        }
                        if (step === 6) { 
                            map.flyTo(locs.macquarie, 15, flyOpts); 
                            setMarkerVisibility(step); m_macquarie.openPopup();
                        }
                    }

                    if (step === 7) {
                        map.flyTo(sydneyOverview, sydneyZoom, { duration: 3 });
                        setMarkerVisibility(step);
                    }

                    lastStep = step;
                }
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('.step').forEach(s => observer.observe(s));
    }, { once: false });
</script>
