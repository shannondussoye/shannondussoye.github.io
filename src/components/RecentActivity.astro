---
import { getUnifiedFeed } from "@/utils/getUnifiedFeed";
import IconMail from "@/assets/icons/IconMail.svg";
import IconCloud from "@/assets/icons/IconMenuDeep.svg"; 
import IconZap from "@/assets/icons/IconArchive.svg"; 
import IconExternal from "@/assets/icons/IconArrowRight.svg";
import IconSparkles from "@/assets/icons/IconSparkles.svg";
import IconEdit from "@/assets/icons/IconEdit.svg";
import IconGlobe from "@/assets/icons/IconGlobe.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";

// 1. FETCH THE UNIFIED FEED
const activityItems = await getUnifiedFeed(25);

// 2. MAP ICONS TO TYPES
const ICON_MAP: Record<string, any> = {
  bluesky: IconCloud,
  substack: IconMail,
  hackernews: IconGlobe,
  raindrop: IconGlobe,
  "github-star": IconGitHub,
  blog: IconEdit,
  workshop: IconSparkles,
  curated: IconZap
};
---

<section id="recent-activity" class="pt-12 pb-6 mt-4">
  <div class="space-y-6 mb-10">
    <h2 class="text-3xl font-bold tracking-tight flex items-center gap-3 text-main">
      <IconZap class="w-7 h-7 text-accent" />
      Unified Digital Pulse
    </h2>
    <p class="text-sm text-dim/80 leading-relaxed max-w-2xl">
      A unified feed of my latest projects, technical reading, and curated interests from across the web.
    </p>
    
    <div class="relative">
      <div 
        class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-hide -mx-2 px-2" 
        id="filter-buttons"
      >
        <button 
          data-filter="all" 
          class="filter-btn active whitespace-nowrap px-5 py-2 rounded-xl bg-border/20 text-[11px] font-black uppercase tracking-[0.15em] text-accent transition-all hover:bg-border/40 border border-transparent"
        >
          All
        </button>
        {["Social", "Writing", "Workshop", "Reading", "Stars"].map(cat => (
          <button 
            data-filter={cat.toLowerCase()} 
            class="filter-btn whitespace-nowrap px-5 py-2 rounded-xl bg-border/10 text-[11px] font-black uppercase tracking-[0.15em] text-dim/60 transition-all hover:bg-border/30 hover:text-dim border border-transparent"
          >
            {cat}
          </button>
        ))}
      </div>
      <!-- Subtle Fade-out for scrolling -->
      <div class="absolute right-0 top-0 bottom-2 w-12 bg-gradient-to-l from-theme-bg to-transparent pointer-events-none md:hidden"></div>
    </div>
  </div>

  <div class="relative group">
    {activityItems.length > 0 ? (
      <div class="rounded-3xl border border-border bg-theme-card/30 backdrop-blur-xl overflow-hidden shadow-2xl">
        <div class="max-h-[600px] overflow-y-auto custom-scrollbar" id="activity-feed">
          {activityItems.map((item) => {
            const Icon = ICON_MAP[item.type] || IconGlobe;
            return (
              <a 
                href={item.link} 
                target={item.link.startsWith('http') ? "_blank" : "_self"}
                rel={item.link.startsWith('http') ? "noopener noreferrer" : ""} 
                data-category={item.category}
                class="activity-item flex gap-4 p-6 border-b border-border/50 last:border-0 hover:bg-white/5 transition-all duration-300 group/item block"
              >
                <div class={`flex-shrink-0 w-10 h-10 rounded-xl bg-border/20 flex items-center justify-center ${item.color} group-hover/item:scale-110 transition-transform`}>
                  <Icon class="w-5 h-5" />
                </div>

                <div class="flex-grow">
                  <div class={`text-[10px] font-black uppercase tracking-widest mb-1 ${item.color}`}>
                    {item.platform} • {item.label}
                  </div>

                  {item.type !== 'bluesky' ? (
                    <>
                      <div class="text-base font-bold mb-1 leading-tight text-main">{item.title}</div>
                      {item.recommendation && (
                        <div class="text-sm text-dim italic border-l-2 border-border pl-4 my-3">
                          "{item.recommendation}"
                        </div>
                      )}
                    </>
                  ) : (
                    <div class="text-base text-main/90 leading-relaxed mb-3 whitespace-pre-wrap">
                      {item.text}
                    </div>
                  )}

                  <div class="flex justify-between items-center text-xs text-dim">
                    <span>{item.displayDate}</span>
                    <IconExternal class="w-4 h-4 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all" />
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ) : (
      <div class="py-16 text-center border border-dashed border-border rounded-3xl text-dim italic bg-white/2">
        Syncing digital pulse...
      </div>
    )}
  </div>
</section>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.activity-item');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update Button Styles
        buttons.forEach(b => {
          b.classList.remove('active', 'bg-border/40', 'text-accent');
          b.classList.add('bg-border/10', 'text-dim/60');
        });
        btn.classList.add('active', 'bg-border/40', 'text-accent');
        btn.classList.remove('bg-border/10', 'text-dim/60');

        // Filter Items
        items.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (item as HTMLElement).style.display = 'flex';
            setTimeout(() => {
              (item as HTMLElement).style.opacity = '1';
              (item as HTMLElement).style.transform = 'translateY(0)';
            }, 10);
          } else {
            (item as HTMLElement).style.opacity = '0';
            (item as HTMLElement).style.transform = 'translateY(10px)';
            setTimeout(() => {
              (item as HTMLElement).style.display = 'none';
            }, 300);
          }
        });
      });
    });
  }

  // Run on initial load and view transitions
  setupFilters();
  document.addEventListener('astro:after-swap', setupFilters);
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .filter-btn {
    border: 1px solid transparent;
  }

  .filter-btn.active {
    box-shadow: 0 0 20px rgba(var(--color-accent-rgb), 0.15);
    border: 1px solid rgba(var(--color-accent-rgb), 0.3);
  }

  .activity-item {
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>
