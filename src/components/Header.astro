---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";

import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

import IconGlobe from "@/assets/icons/IconGlobe.svg";
import IconSparkles from "@/assets/icons/IconSparkles.svg";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const menuLinks = [
  { name: "Posts", href: "/posts", index: "01" },
  { name: "Shelf", href: "/shelf", index: "02" },
  { name: "Atlas", href: "/atlas", index: "03" },
  { name: "About", href: "/about", index: "04" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header
  class="fixed top-0 z-50 w-full transition-all duration-300"
  id="main-header"
>
  <div
    id="top-nav-wrap"
    class:list={[
      "mx-auto max-w-app px-4 py-4 sm:py-6",
      "transition-all duration-300",
      "flex items-baseline justify-between sm:items-center",
    ]}
  >
    <a
      href="/"
      class="py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none relative z-[110]"
    >
      {SITE.title}
    </a>

    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <!-- Menu Button -->
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden relative z-[110]"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>

      <!-- Desktop Navigation (Hidden on Mobile) -->
      <ul
        id="desktop-menu"
        class="hidden sm:flex sm:flex-row sm:items-center sm:justify-end sm:gap-x-5"
      >
        <li>
          <a href="/posts" class:list={["hover:text-accent transition-colors", { "text-accent": isActive("/posts") }]}>
            Posts
          </a>
        </li>
        <li>
          <a href="/about" class:list={["hover:text-accent transition-colors", { "text-accent": isActive("/about") }]}>
            About
          </a>
        </li>

        <!-- Desktop Utility Icons -->
        <li class="flex items-center justify-center border-l border-border ml-2 pl-4 gap-4">
            <LinkButton
              href="/workshop"
              class:list={["focus-outline flex p-1 hover:text-accent transition-colors", { "text-accent": isActive("/workshop") }]}
              title="Workshop"
              aria-label="workshop"
            >
              <IconSparkles />
              <span class="sr-only">Workshop</span>
            </LinkButton>

            <LinkButton
              href="/shelf"
              class:list={["focus-outline flex p-1 hover:text-accent transition-colors", { "text-accent": isActive("/shelf") }]}
              title="Shelf"
              aria-label="shelf"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-bookshelf"><path d="M5 4h4v12h-4z" /><path d="M9 4h4v12h-4z" /><path d="M15 4h4v12h-4z" /><path d="M4 20h16" /></svg>
              <span class="sr-only">Shelf</span>
            </LinkButton>

            <LinkButton
              href="/atlas"
              class:list={["focus-outline flex p-1 hover:text-accent transition-colors", { "text-accent": isActive("/atlas") }]}
              title="Atlas"
              aria-label="atlas"
            >
              <IconGlobe />
              <span class="sr-only">Atlas</span>
            </LinkButton>

            <LinkButton
              href="/search"
              class:list={["focus-outline flex p-1 hover:text-accent transition-colors", { "text-accent": isActive("/search") }]}
              title="Search"
              aria-label="search"
            >
              <IconSearch />
              <span class="sr-only">Search</span>
            </LinkButton>
        </li>

        {
          SITE.lightAndDarkMode && (
            <li>
              <button
                id="theme-btn-desktop"
                class="focus-outline theme-toggle relative size-8 p-1 hover:text-accent transition-colors"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
    
</header>

  <!-- Mobile Menu Overlay (Editorial Style) -->
  <div 
    id="mobile-menu-overlay" 
    data-state="closed"
    class="fixed inset-0 z-[100] bg-background flex flex-col justify-between p-8 sm:hidden"
  >
    <!-- Top Branding -->
    <div class="text-xs font-black tracking-[0.3em] uppercase opacity-40 mt-6 text-foreground">Navigation</div>

    <!-- Close Button (Inside Overlay) -->
    <button
      id="overlay-close-btn"
      class="absolute top-6 right-4 p-2 focus-outline text-foreground z-50"
      aria-label="Close Menu"
    >
      <IconX class="w-8 h-8" />
    </button>

    <!-- Main Links -->
    <nav class="flex flex-col gap-4">
      {menuLinks.map((link, i) => (
        <a 
          href={link.href} 
          class="menu-link group flex items-baseline gap-6"
          style={`transition-delay: ${150 + i * 100}ms`}
        >
          <span class="text-xs font-mono text-foreground/50 group-hover:text-accent transition-colors">{link.index}</span>
          <span class="text-6xl sm:text-7xl font-serif font-black tracking-tighter text-foreground group-hover:italic group-hover:text-accent transition-all">{link.name}</span>
        </a>
      ))}
    </nav>

    <!-- Footer -->
    <div class="menu-footer flex justify-between items-end border-t border-border pt-8 delay-500">
      <div class="flex flex-col gap-4">
        <span class="text-xs font-bold uppercase tracking-widest opacity-50 text-foreground">Socials</span>
        <div class="flex gap-6">
          {SOCIALS.map(social => (
            <a 
              href={social.href} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-foreground/60 hover:text-accent transition-colors"
              aria-label={social.linkTitle}
            >
              <social.icon class="w-6 h-6" />
            </a>
          ))}
        </div>
      </div>
      
      <div class="flex gap-4">
         <a href="/search" class="p-4 rounded-full border border-border hover:bg-muted text-foreground transition-colors" aria-label="Search">
            <IconSearch class="w-6 h-6" />
         </a>
         {SITE.lightAndDarkMode && (
           <button
             id="theme-btn-mobile"
             class="theme-toggle p-4 rounded-full border border-border hover:bg-muted text-foreground transition-colors relative overflow-hidden"
             aria-label="Toggle Theme"
           >
             <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] w-6 h-6 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
             <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] w-6 h-6 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
           </button>
         )}
      </div>
    </div>
  </div>

<style>
  /* Header Scroll Effect */
  #main-header.scrolled {
    border-bottom: 1px solid color-mix(in srgb, var(--border), transparent 50%);
    background-color: color-mix(in srgb, var(--background), transparent 20%);
    backdrop-filter: blur(12px);
  }
  #main-header.scrolled #top-nav-wrap {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  @media (min-width: 640px) {
    #main-header.scrolled #top-nav-wrap {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }

  /* Font Serif for Editorial Menu */
  .font-serif {
    font-family: 'Playfair Display', serif;
  }

  /* 
    MOBILE MENU STATE MANAGEMENT 
    Using data-state for reliable transitions
  */
  #mobile-menu-overlay {
    transform: translateY(100%);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  #mobile-menu-overlay[data-state="open"] {
    transform: translateY(0);
  }
  
  /* Link Animations */
  #mobile-menu-overlay .menu-link,
  #mobile-menu-overlay .menu-footer {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Trigger link animations when open */
  #mobile-menu-overlay[data-state="open"] .menu-link,
  #mobile-menu-overlay[data-state="open"] .menu-footer {
    opacity: 1;
    transform: translateY(0);
  }

  /* Lock body scroll */
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  function setupHeader() {
    const header = document.querySelector("#main-header");
    if (!header) return;

    const handleScroll = () => {
      if (window.scrollY > 0) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };

    window.addEventListener("scroll", handleScroll);
    handleScroll(); 
  }

  function initMobileMenu() {
    const menuBtn = document.getElementById("menu-btn");
    const overlay = document.getElementById("mobile-menu-overlay");
    const closeIcon = document.getElementById("close-icon");
    const menuIcon = document.getElementById("menu-icon");

    if (!menuBtn || !overlay || !closeIcon || !menuIcon) return;

    // Remove old listeners to be safe (cloning)
    const newBtn = menuBtn.cloneNode(true) as HTMLButtonElement;
    menuBtn.parentNode?.replaceChild(newBtn, menuBtn);
    
    newBtn.addEventListener("click", () => {
      const isOpen = overlay.getAttribute("data-state") === "open";
      const newState = isOpen ? "closed" : "open";
      
      // Update Overlay State
      overlay.setAttribute("data-state", newState);
      
      // Update ARIA
      newBtn.setAttribute("aria-expanded", String(!isOpen));
      newBtn.setAttribute("aria-label", isOpen ? "Open Menu" : "Close Menu");
      
      // Toggle Body Scroll Lock
      if (!isOpen) {
        document.body.classList.add("menu-open");
      } else {
        document.body.classList.remove("menu-open");
      }

      // Toggle Icons
      const cIcon = newBtn.querySelector("#close-icon");
      const mIcon = newBtn.querySelector("#menu-icon");
      if (cIcon && mIcon) { 
         cIcon.classList.toggle("hidden");
         mIcon.classList.toggle("hidden");
      }
    });

    // Close Button Logic (Inside Overlay)
    const overlayCloseBtn = document.getElementById("overlay-close-btn");
    if (overlayCloseBtn) {
      overlayCloseBtn.addEventListener("click", () => {
        // Force Close
        overlay.setAttribute("data-state", "closed");
        newBtn.setAttribute("aria-expanded", "false");
        newBtn.setAttribute("aria-label", "Open Menu");
        document.body.classList.remove("menu-open");

        // Reset Main Button Icons
        const cIcon = newBtn.querySelector("#close-icon");
        const mIcon = newBtn.querySelector("#menu-icon");
        if (cIcon && mIcon) {
           cIcon.classList.add("hidden");
           mIcon.classList.remove("hidden");
        }
      });
    }

    // Theme logic
    const themeBtns = document.querySelectorAll(".theme-toggle");
    themeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
          const current = document.documentElement.getAttribute("data-theme");
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
          if (window.theme) window.theme.setTheme(next);
      });
    });
  }

  // Orchestrate execution
  function init() {
    setupHeader();
    initMobileMenu();
  }

  // Run immediately and on view transitions
  init();
  document.addEventListener("astro:after-swap", init);
</script>
