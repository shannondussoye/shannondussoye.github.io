---
interface Props {
  title?: string;
}

const { title = "shannon@portfolio — terminal" } = Astro.props;
---

<div class="terminal-header flex-none flex items-center justify-between px-4 py-2 border-b border-white/10 bg-white/5 select-none rounded-t-2xl">
  <div class="flex gap-2">
    <div class="w-3 h-3 rounded-full bg-[#ff5f57] cursor-pointer hover:opacity-80 transition-opacity" id="close-terminal"></div>
    <div class="w-3 h-3 rounded-full bg-[#febc2e]"></div>
    <div class="w-3 h-3 rounded-full bg-[#28c840]"></div>
  </div>
  <div class="text-[10px] uppercase tracking-widest text-white/40 font-bold">{title}</div>
  <div class="w-12"></div>
</div>

<style>
  .terminal-header {
    backdrop-filter: blur(4px);
  }
</style>
